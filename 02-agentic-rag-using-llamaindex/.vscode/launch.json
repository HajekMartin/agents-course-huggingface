{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "02 - Alfred (LlamaIndex + Ollama)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/app.py",
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/bin/python",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "02 - Alfred (with web search)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/app.py",
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/bin/python",
      "args": [
        "--enable-web"
      ],
      "console": "integratedTerminal",
      "justMyCode": true
    }
  ]
}
